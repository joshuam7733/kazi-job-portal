# ─── Core ──────────────────────────────────────────────────────────────
# Public base URL (used for canonical URLs, sitemap, emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL. `npm run db:local` starts a local server matching this URL.
DATABASE_URL="postgresql://kazi:kazi@localhost:5433/kazi"
# Direct (non-pooled) connection used by migrations. Same as DATABASE_URL unless you use a pooler (e.g. Neon).
DIRECT_URL="postgresql://kazi:kazi@localhost:5433/kazi"

# Prototype mode for client reviews: banner, demo logins on sign-in, no search indexing.
DEMO_MODE="false"

# Auth.js — generate with: npx auth secret   (or any 32+ byte random string)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# ─── Optional: Google sign-in (button hidden when unset) ───────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Optional: Email (SMTP). When unset, emails are written to ./storage/mail
# and viewable at /dev/mail in development. ─────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="KAZI Job Portal <no-reply@kazi.example>"
# Block applying until the address is verified (only enforced when SMTP is configured)
REQUIRE_EMAIL_VERIFICATION="false"

# ─── File storage: "local" (./storage/uploads), "database" (serverless prototypes) or "s3" ───
STORAGE_DRIVER="local"
S3_ENDPOINT=""          # e.g. https://<account>.r2.cloudflarestorage.com or https://s3.eu-west-1.amazonaws.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Scheduled jobs (job alerts). Call GET /api/cron/job-alerts with
# header `Authorization: Bearer $CRON_SECRET` from your scheduler. ───────
CRON_SECRET="replace-with-another-random-string"
